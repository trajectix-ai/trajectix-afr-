# Copy this file to .env and fill in your keys.
# .env is git-ignored — never commit real keys.

# Your Google AI Studio API key (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Analysis engine selector:
#   gemma   — Gemma 4 (gemma-4-31b-it) via google-genai SDK  [default]
#   gemini  — Gemini 2.5 Pro via google-generativeai SDK
ANALYSIS_MODEL=gemma
